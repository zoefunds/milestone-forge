# Copy to .env and fill in real values. Never commit .env.

PORT=8080
NODE_ENV=production

# Postgres (Docker on Fly.io)
DATABASE_URL=postgres://milestoneforge:changeme@localhost:5432/milestoneforge

# GenLayer StudioNet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
# Filled in by the user after they deploy the contract themselves.
MILESTONE_FORGE_CONTRACT_ADDRESS=

# Redis (Upstash) — used ONLY as a cross-instance shared counter to stay
# under GenLayer's 30 requests/minute limit. Not used as a general cache or
# for per-HTTP-request rate limiting (that's in-memory, see rateLimiter.ts).
REDIS_URL=

# Session signing secret for SIWE JWT issuance (generate a long random value)
SESSION_JWT_SECRET=

# Reown (WalletConnect) — public project id, safe to expose to the frontend
REOWN_PROJECT_ID=

# CORS
FRONTEND_ORIGIN=http://localhost:3000
